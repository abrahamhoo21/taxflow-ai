erDiagram
    LEADS ||--o{ OPPORTUNITIES : "1 : N (CASCADE)"
    LEADS ||--o{ ACTIVITIES : "1 : N (CASCADE)"
    OPPORTUNITIES ||--o{ ACTIVITIES : "1 : N (SET NULL)"

    LEADS {
        UUID id PK
        VARCHAR name
        VARCHAR email
        VARCHAR phone
        VARCHAR company
        VARCHAR status
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    OPPORTUNITIES {
        UUID id PK
        UUID lead_id FK
        VARCHAR title
        DECIMAL value_rm
        VARCHAR stage
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    ACTIVITIES {
        UUID id PK
        UUID lead_id FK
        UUID opportunity_id FK
        VARCHAR type
        TIMESTAMPTZ date
        TEXT description
        TIMESTAMPTZ created_at
    }

    TAX_DOCUMENT_CHUNKS {
        UUID id PK
        VARCHAR doc_name
        INTEGER page_number
        VARCHAR section_title
        TEXT chunk_content
        VECTOR embedding
        JSONB metadata
        TIMESTAMPTZ created_at
    }
