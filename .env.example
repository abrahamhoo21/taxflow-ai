# ====================================================================
# Environment Variables Example Template
# Duplicate this file as .env.local and fill in your actual credentials.
# NEVER commit .env.local or real secrets to Git.
# ====================================================================

# 1. Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Configuration (PostgreSQL + pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
